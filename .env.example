# Copy this to .env and fill in your values
SECRET_KEY=change-this-to-a-random-secret-key
PORT=5000
FLASK_DEBUG=false

# Optional: override DB path
# DATABASE_URL=sqlite:////absolute/path/to/watchdog.db

# EPICS environment (set these before starting if needed)
# EPICS_CA_ADDR_LIST=192.168.1.255
# EPICS_CA_AUTO_ADDR_LIST=NO
