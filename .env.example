# Copy this file to .env and fill in your values before starting in production.
#
# Generate a secure SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-this-with-a-random-64-char-hex-string

# Port to listen on (default: 5001)
PORT=5001

# Database path (default: instance/watchdog.db)
# DATABASE_URL=sqlite:///instance/watchdog.db
